{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "name": "@danzigergeist/genesys-function-email-router",
  "description": "A Genesys Cloud function that classifies an inbound email against datatable rules and routes it accordingly",
  "version": "0.1.0",
  "license": "MIT",
  "repository": "https://github.com/DanzigerGeist/genesys-function-email-router",
  "exports": {
    ".": "./src/mod.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.19",
    "aws-lambda": "npm:@types/aws-lambda@^8.10.162",
    "purecloud-platform-client-v2": "npm:purecloud-platform-client-v2@^261.0.0"
  },
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "isolatedDeclarations": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true
  },
  "test": {
    "sanitizeOps": true,
    "sanitizeResources": true
  },
  "tasks": {
    "benchmark": {
      "description": "Run benchmarks",
      "command": "deno bench benchmarks/ --permit-no-files --quiet --no-prompt"
    },
    "build:genesys": {
      "description": "Bundle function into target/index.js (CJS, non-obfuscated)",
      "command": "mkdir -p target && deno bundle --platform=deno --format=cjs src/mod.ts > target/index.js"
    },
    "build:genesys:zip": {
      "description": "Create Genesys Cloud function zip in target/index.zip",
      "dependencies": [
        "build:genesys"
      ],
      "command": "cd target && zip -qj index.zip index.js"
    },
    "check": {
      "description": "Run dependency, docs, format, lint, type and example checks",
      "dependencies": [
        "check:dependencies",
        "check:examples",
        "check:format",
        "check:lint",
        "check:types"
      ]
    },
    "check:dependencies": {
      "description": "Install dependencies strictly from the lockfile",
      "command": "deno ci"
    },
    "check:examples": {
      "description": "Type-check JSDoc example blocks (they call live Genesys, so they are checked, not executed)",
      "command": "deno check --doc-only src/"
    },
    "check:format": {
      "description": "Validate code formatting",
      "command": "deno fmt --check"
    },
    "check:lint": {
      "description": "Run lint checks",
      "command": "deno lint"
    },
    "check:types": {
      "description": "Type-check the function source, tests, and deploy script",
      "command": "deno check src/ tests/ scripts/"
    },
    "ci": {
      "description": "Run every gate CI runs: checks, coverage, security, and the zip build",
      "dependencies": [
        "check",
        "coverage",
        "security",
        "build:genesys:zip"
      ]
    },
    "clean": {
      "description": "Remove cache and generated artifacts",
      "dependencies": [
        "clean:cache",
        "clean:coverage",
        "clean:target"
      ]
    },
    "clean:cache": {
      "description": "Clear Deno cache",
      "command": "deno clean"
    },
    "clean:coverage": {
      "description": "Remove coverage artifacts",
      "command": "rm -rf .coverage"
    },
    "clean:target": {
      "description": "Remove target artifacts",
      "command": "rm -rf target"
    },
    "coverage": {
      "description": "Report coverage and enforce the thresholds configured in deno.json",
      "dependencies": [
        "test"
      ],
      "command": "deno coverage .coverage"
    },
    "publish": {
      "description": "Deploy the function to Genesys Cloud, setting up anything missing",
      "dependencies": [
        "ci"
      ],
      "command": "deno run -A scripts/publish.ts"
    },
    "security": {
      "description": "Run security checks",
      "dependencies": [
        "security:secrets",
        "security:vulnerabilities"
      ]
    },
    "security:secrets": {
      "description": "Scan repository and Git history for leaked credentials (requires gitleaks)",
      "dependencies": [
        "security:secrets:files",
        "security:secrets:history"
      ]
    },
    "security:secrets:files": {
      "description": "Scan working tree for leaked credentials (requires gitleaks)",
      "command": "gitleaks dir . --redact --verbose"
    },
    "security:secrets:history": {
      "description": "Scan Git history for leaked credentials (requires gitleaks)",
      "command": "gitleaks git . --redact --verbose"
    },
    "security:vulnerabilities": {
      "description": "Scan dependencies for known vulnerabilities",
      "command": "deno audit --frozen --level=high"
    },
    "setup": {
      "description": "Perform a repository setup",
      "dependencies": [
        "setup:dependencies",
        "setup:cog"
      ]
    },
    "setup:cog": {
      "description": "Install Cog-managed Git hooks into .git/hooks",
      "command": "cog install-hook --all --overwrite"
    },
    "setup:dependencies": {
      "description": "Install project dependencies into Deno cache",
      "command": "deno install"
    },
    "test": {
      "description": "Run test suite, reporting every failure",
      "command": "deno test tests/ --coverage=.coverage --parallel --quiet --no-prompt --allow-env --allow-sys --allow-read --permit-no-files"
    },
    "test:fast": {
      "description": "Run test suite, stopping at the first failure",
      "command": "deno test tests/ --coverage=.coverage --parallel --quiet --fail-fast --no-prompt --allow-env --allow-sys --allow-read --permit-no-files"
    },
    "update": {
      "description": "Update dependencies within current semver ranges",
      "command": "deno outdated --update"
    },
    "update:interactive": {
      "description": "Interactively choose dependency updates",
      "command": "deno outdated --update --interactive"
    },
    "update:latest": {
      "description": "Update dependencies to latest versions (ignore current semver ranges)",
      "command": "deno outdated --update --latest"
    },
    "version": {
      "description": "Print package metadata from deno.json",
      "command": "deno eval \"const cfg = JSON.parse(await Deno.readTextFile('deno.json')); const rows = [['Name', cfg.name ?? ''], ['Version', cfg.version ?? ''], ['Description', cfg.description ?? '']]; const width = Math.max(...rows.map((row) => row[0].length)); console.log('Package metadata'); console.log('----------------'); for (const row of rows) { console.log(row[0].padEnd(width) + ' : ' + row[1]); }\""
    }
  },
  "exclude": [
    ".coverage/",
    "target/"
  ],
  "fmt": {
    "lineWidth": 120,
    "include": [
      "README.md",
      "benchmarks/",
      "scripts/",
      "src/",
      "tests/"
    ],
    "exclude": [
      ".coverage/",
      "target/"
    ]
  },
  "lint": {
    "include": [
      "benchmarks/",
      "src/",
      "tests/"
    ],
    "exclude": [
      ".coverage/",
      "target/"
    ],
    "rules": {
      "tags": [
        "recommended",
        "jsr",
        "workspace"
      ],
      "include": [
        "ban-untagged-todo",
        "default-param-last",
        "eqeqeq",
        "explicit-module-boundary-types",
        "no-console",
        "no-eval",
        "no-implicit-declare-namespace-export",
        "no-node-globals",
        "no-non-null-assertion",
        "no-process-global",
        "no-self-compare",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-top-level-await",
        "no-undef",
        "no-useless-rename",
        "triple-slash-reference"
      ]
    }
  },
  "coverage": {
    "thresholds": {
      "branches": 80,
      "functions": 100,
      "lines": 80
    }
  }
}
